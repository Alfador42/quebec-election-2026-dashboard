{
  "name": "quebec-2026-polling-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "update": "node pipeline/cli.mjs update",
    "rebuild": "node pipeline/cli.mjs build",
    "review": "node pipeline/cli.mjs review",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win portable --x64",
    "desktop:smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "main": "desktop/main.mjs",
  "description": "Québec 2026 independent polling intelligence desktop",
  "author": "Québec Polling Desk",
  "build": {
    "appId": "org.quebec2026.pollingdesk",
    "productName": "Quebec 2026 Polling Desk",
    "directories": {
      "output": "desktop-app"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Quebec-2026-Dashboard.exe"
    },
    "compression": "store"
  }
}
